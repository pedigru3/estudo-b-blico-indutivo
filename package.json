{
  "name": "estudo-biblico",
  "version": "1.0.0",
  "description": "Plataforma de Estudo Bíblico",
  "main": "index.js",
  "scripts": {
    "dev": "node infra/scripts/services-init.js",
    "build": "next build",
    "test": "node infra/scripts/run-tests-with-cleanup.js",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "services:delete:database": "docker compose -f infra/compose.yaml down -v",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate -m infra/migrations down",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "next lint --dir .",
    "lint:eslint:fix": "eslint --fix ."
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "async-retry": "1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "1.0.2",
    "dotenv": "16.4.4",
    "dotenv-expand": "11.0.6",
    "lucide-react": "^1.54.0",
    "next": "^14.2.35",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "pg": "8.16.3",
    "postcss": "^8.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swr": "2.2.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.8.0",
    "jest": "29.7.0",
    "prettier": "3.6.2"
  }
}
